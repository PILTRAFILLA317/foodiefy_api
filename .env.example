APP_ENV=local
ENABLE_LEGACY_IMPORT=false
LEGACY_BUDGET_USD=0

# Public Supabase client configuration.
# Never use a service-role key here; SUPABASE_PUBLISHABLE_KEY is safe for the client.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=

# Server-side AI provider configuration.
OPENAI_API_KEY=
OPENAI_TRANSCRIBE_MODEL=gpt-transcribe
OPENAI_RECIPE_MODEL=gpt-5-nano

# Optional until the visual phase is enabled.
GEMINI_API_KEY=
GEMINI_VISUAL_MODEL=gemini-2.5-flash

# Phase 06: server-only configuration; paid authorization is per CLI attempt.
OPENAI_API_KEY=
STT_MODEL=gpt-transcribe
RECIPE_EXTRACTOR_MODEL=gpt-5-nano
ENABLE_VISUAL_FALLBACK=false
VISUAL_MODEL=gemini-2.5-flash
AI_TIMEOUT_SECONDS=60
AI_MAX_OUTPUT_TOKENS=6000
AI_MAX_INPUT_BYTES=80000
AI_TRANSIENT_RETRIES=0

# Phase 08: server-only configuration. JWT secret is for local legacy HS256 only.
IMPORT_DATABASE_URL=
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_JWT_SECRET=
IMPORT_ALLOW_PAID=false
IMPORT_ALLOW_LOCAL_SOCIAL=false
IMPORT_MAX_DURATION_SECONDS=300
IMPORT_MAX_MEDIA_BYTES=52428800
